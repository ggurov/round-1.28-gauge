menu "Round gauge BSP"

menu "LCD (GC9A01A 240x240 SPI)"

config BSP_LCD_H_RES
    int "Horizontal resolution"
    default 240

config BSP_LCD_V_RES
    int "Vertical resolution"
    default 240

config BSP_LCD_SPI_HOST
    int "SPI peripheral (2 = SPI2/FSPI, 3 = SPI3)"
    range 1 3
    default 2

config BSP_LCD_PIN_SCK
    int "SCLK GPIO"
    default 10

config BSP_LCD_PIN_MOSI
    int "MOSI GPIO"
    default 11

config BSP_LCD_PIN_CS
    int "CS GPIO"
    default 9

config BSP_LCD_PIN_DC
    int "DC GPIO"
    default 8

config BSP_LCD_PIN_RST
    int "RESET GPIO"
    default 12

config BSP_LCD_PIN_BL
    int "Backlight GPIO (-1 to disable)"
    default 40

config BSP_LCD_SPI_CLK_MHZ
    int "SPI clock (MHz)"
    range 10 80
    default 80
    help
        The Waveshare board and GC9A01A are rated to 80 MHz.  Drop to 40 MHz
        if you see shimmering or torn pixels.

config BSP_LCD_INVERT_COLOR
    bool "Invert panel colours"
    default y
    help
        GC9A01A panels on the Waveshare board are normally driven inverted.
        Turn this off if the whole dial looks like a colour negative.

config BSP_LCD_SWAP_RGB565_BYTES
    bool "Byte-swap RGB565 before SPI transmit"
    default y
    help
        LVGL renders RGB565 little-endian; the GC9A01A latches the high byte
        first.  Turn this off only if you have verified the panel accepts
        little-endian pixel data.

config BSP_LCD_BUFFER_LINES
    int "Draw buffer height in lines"
    range 8 120
    default 40

endmenu

config BSP_BACKLIGHT_DEFAULT_PERCENT
    int "Backlight level at boot (0-100)"
    range 0 100
    default 85

endmenu
