menu "Round gauge BSP"

menu "LCD (GC9A01A 240x240 SPI)"

config BSP_LCD_H_RES
    int "Horizontal resolution"
    default 240

config BSP_LCD_V_RES
    int "Vertical resolution"
    default 240

config BSP_LCD_SPI_HOST
    int "SPI peripheral (2 = SPI2/FSPI, 3 = SPI3)"
    range 1 3
    default 2

config BSP_LCD_PIN_SCK
    int "SCLK GPIO"
    default 10

config BSP_LCD_PIN_MOSI
    int "MOSI GPIO"
    default 11

config BSP_LCD_PIN_CS
    int "CS GPIO"
    default 9

config BSP_LCD_PIN_DC
    int "DC GPIO"
    default 8

config BSP_LCD_PIN_RST
    int "RESET GPIO"
    default 12

config BSP_LCD_PIN_BL
    int "Backlight GPIO (-1 to disable)"
    default 40

config BSP_LCD_SPI_CLK_MHZ
    int "SPI clock (MHz)"
    range 10 80
    default 20
    help
        This board's 3.3V rail sags when the panel is driven hard, which
        corrupts SPI traffic and browns the chip out.  20 MHz keeps the peak
        current down; the Waveshare board and GC9A01A are good to 80 MHz on a
        supply that can take it.

config BSP_LCD_INVERT_COLOR
    bool "Invert panel colours"
    default y
    help
        GC9A01A panels on the Waveshare board are normally driven inverted.
        Turn this off if the whole dial looks like a colour negative.

config BSP_LCD_SWAP_XY
    bool "Exchange X and Y axes (90 degree rotation)"
    default n
    help
        Maps to the MV bit of MADCTL.  Together with the two mirror options
        this gives all eight axis mappings; change them if the dial comes up
        rotated or mirrored relative to the board's natural upright position.

config BSP_LCD_MIRROR_X
    bool "Mirror horizontally (180/90 degree combinations)"
    default n

config BSP_LCD_MIRROR_Y
    bool "Mirror vertically (180/90 degree combinations)"
    default n

config BSP_LCD_SWAP_RGB565_BYTES
    bool "Byte-swap RGB565 before SPI transmit"
    default y
    help
        LVGL renders RGB565 little-endian; the GC9A01A latches the high byte
        first.  Turn this off only if you have verified the panel accepts
        little-endian pixel data.

config BSP_LCD_BUFFER_LINES
    int "Draw buffer height in lines"
    range 8 120
    default 40
    depends on !BSP_LCD_RENDER_FULL

config BSP_LCD_RENDER_FULL
    bool "Render whole frames instead of partial tiles"
    default n
    help
        Tried as a fix for lost tiles; it renders even less on this board (only
        the root object's border survives), so it is off by default.  Kept
        because it is the right mode on a healthy board and makes a useful
        A/B test.

endmenu

config BSP_BACKLIGHT_DEFAULT_PERCENT
    int "Backlight level at boot (0-100)"
    range 0 100
    default 35
    help
        The backlight is the board's biggest current draw and this board's
        3.3V rail is marginal.  Start low and raise it with `backlight 100`
        once the supply is known good.

config BSP_LCD_HEAL_PERIOD_MS
    int "Full repaint interval (ms, 0 to disable)"
    range 0 10000
    default 1000
    help
        This board loses display tiles: an area is painted correctly, then goes
        black and stays black until something invalidates it again.  A periodic
        full repaint makes the dial come back on its own instead of staying
        broken.  Costs one full-screen transfer per interval, so keep it long
        unless the tiles are being lost often.  `redraw` on the console forces
        one by hand.

endmenu
